# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
NUXT_SUPABASE_SECRET_KEY=your-service-role-key
# Storage：需在 Supabase 创建公开 bucket「bearkid-media」
# 可执行 supabase/migrations/0005_bearkid_media_bucket.sql

# 千问3-ASR-Flash（语音转文字，中国内地）
# 文档: CodingDoc/Qwen3-ASR-Flash
QWEN3_ASR_FLASH_API_KEY=sk-your-dashscope-api-key
# 可选：国际地域用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN3_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# CosyVoice TTS（与 ASR 共用 DashScope Key，仅中国内地）
# 文档: CodingDoc/CosyVoice-3-TTS.md
# COSYVOICE_MODEL=cosyvoice-v3.5-flash
# 测试默认系统音色（v3-flash）：longanyang
# v3.5 正式环境请配置声音设计/复刻后的 voice ID：
# COSYVOICE_VOICE=your-cloned-voice-id
# COSYVOICE_INSTRUCTION=请用活泼俏皮的语气说话，带着明显的笑意。

# OpenRouter — Gemini 3.5 Flash
# 文档: https://openrouter.ai/google/gemini-3.5-flash/api
OPENROUTER_GEMINI35_FLASH_API_KEY=sk-or-v1-your-key-here
# 可选：覆盖默认模型
# OPENROUTER_MODEL=google/gemini-3.5-flash

# Resend（OTP 邮件，发件域名 mail.eazzyai.com）
NUXT_RESEND_API_KEY=re_your-resend-api-key

# App
NUXT_PUBLIC_APP_URL=http://localhost:3000
